generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

// =========================
// ROLES
// =========================

model Rol {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique @db.VarChar(50)

  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// =========================
// USUARIOS
// =========================

model Usuario {
  id       String  @id @default(uuid()) @db.Uuid
  nombre   String  @db.VarChar(100)
  email    String  @unique @db.VarChar(150)
  password String
  activo   Boolean @default(true)

  rolId String @db.Uuid
  rol   Rol    @relation(fields: [rolId], references: [id])

  movimientosInventario MovimientoInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rolId])
  @@map("usuarios")
}

// =========================
// SUCURSALES
// =========================

model Sucursal {
  id        String  @id @default(uuid()) @db.Uuid
  nombre    String  @db.VarChar(100)
  direccion String? @db.VarChar(200)
  telefono  String? @db.VarChar(20)
  activo    Boolean @default(true)

  inventarios           Inventario[]
  movimientosInventario MovimientoInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sucursales")
}

// =========================
// CATEGORIAS
// =========================

model Categoria {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.Text
  activo      Boolean @default(true)

  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categorias")
}

// =========================
// PRODUCTOS
// =========================

model Producto {
  id String @id @default(uuid()) @db.Uuid

  categoriaId String    @db.Uuid
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  nombre       String  @db.VarChar(150)
  descripcion  String? @db.Text
  codigoBarras String? @unique @db.VarChar(50)

  precioCompra Decimal @db.Decimal(12, 2)
  precioVenta  Decimal @db.Decimal(12, 2)

  stockMinimo Int     @default(0)
  activo      Boolean @default(true)

  inventarios           Inventario[]
  movimientosInventario MovimientoInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoriaId])
  @@map("productos")
}

// =========================
// INVENTARIO
// =========================

model Inventario {
  id String @id @default(uuid()) @db.Uuid

  sucursalId String   @db.Uuid
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  productoId String   @db.Uuid
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([sucursalId, productoId])
  @@index([productoId])
  @@map("inventarios")
}

// =========================
// MOVIMIENTOS DE INVENTARIO
// =========================

model MovimientoInventario {
  id String @id @default(uuid()) @db.Uuid

  sucursalId String   @db.Uuid
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  productoId String   @db.Uuid
  producto   Producto @relation(fields: [productoId], references: [id])

  usuarioId String  @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo     TipoMovimiento
  cantidad Int

  precioUnitario Decimal? @db.Decimal(12, 2)
  costoUnitario  Decimal? @db.Decimal(12, 2)

  totalVenta Decimal? @db.Decimal(12, 2)
  utilidad   Decimal? @db.Decimal(12, 2)

  observacion String? @db.Text

  createdAt DateTime @default(now())

  @@index([sucursalId])
  @@index([productoId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([createdAt])
  @@map("movimientos_inventario")
}
